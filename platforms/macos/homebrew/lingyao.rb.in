# Casks/lingyao.rb in metasequoiaime/homebrew-tap, written by release-macos.yml; edit this template, not the tap.
cask "lingyao" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/Lcy040109/msime/releases/download/macos-v#{version}/msime-macos-#{version}-universal.dmg"
  name "LINGYAO"
  name "灵耀输入法"
  desc "Chinese input method for pinyin, shuangpin and wubi"
  homepage "https://github.com/Lcy040109/msime"

  livecheck do
    url :url
    regex(/^macos-v(\d+(?:\.\d+)+)$/i)
    strategy :github_releases
  end

  depends_on macos: :ventura

  app "LINGYAO.app"
  # The MCP server AI assistants run, on PATH for those configured from a terminal.
  binary "#{appdir}/LINGYAO.app/Contents/MacOS/lingyao-mcp"
  # 同一个程序再以 lingyao 的名字放上 PATH，方便在终端里手动敲 lingyao expand、lingyao config。
  binary "#{appdir}/LINGYAO.app/Contents/MacOS/lingyao-mcp", target: "lingyao"

  # The settings app copies the input method here on its first launch.
  uninstall quit:   ["app.lingyao.macos", "app.lingyao.inputmethod.LingyaoIME"],
            delete: "~/Library/Input Methods/灵耀输入法.app"

  zap trash: [
    "~/Library/Application Support/app.lingyao.macos",
    "~/Library/Caches/app.lingyao.macos",
    "~/Library/Preferences/app.lingyao.macos.plist",
    "~/Library/Preferences/app.lingyao.inputmethod.LingyaoIME.plist",
    "~/Library/Saved Application State/app.lingyao.macos.savedState",
    "~/Library/WebKit/app.lingyao.macos",
  ]

  caveats <<~EOS
    Open LINGYAO once to finish installing: it adds 灵耀输入法 to your input sources.
    On a Mac where it was never installed, log out and back in after that before it appears.
  EOS
end
