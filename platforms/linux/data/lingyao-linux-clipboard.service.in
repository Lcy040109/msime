[Unit]
Description=LINGYAO clipboard history monitor
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart="@CMAKE_INSTALL_FULL_BINDIR@/lingyao-linux-clipboard-monitor" "%E/lingyao-client/runtime-options.json"
UMask=0077
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=2

[Install]
WantedBy=graphical-session.target
